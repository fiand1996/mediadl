# ==========================================
# Application Configuration
# ==========================================

# Application URL (Pure server-side runtime reading)
APP_URL=""

# Optional FFmpeg Path (enables high-res 1080p/4K audio+video merging)
# FFMPEG_PATH="/Users/vian/Downloads/ffmpeg"
FFMPEG_PATH=""

# Optional explicit yt-dlp binary path (if not available in system PATH)
# YTDLP_PATH="/usr/local/bin/yt-dlp"
YTDLP_PATH=""


# ==========================================
# Authentication Configuration (NextAuth / Auth.js)
# ==========================================

# Secret key used to encrypt tokens and session data (generate using: openssl rand -base64 32)
AUTH_SECRET=""

# Base URL of the authentication server
AUTH_URL=""

# OIDC Provider Type: choose ONE ("github", "google", or "custom")
# Leave empty if you only want database credentials login
OIDC_PROVIDER=""

# If OIDC_PROVIDER="custom", provide your OIDC endpoint details (Keycloak, Authentik, Authelia, Zitadel, etc.)
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""

# If OIDC_PROVIDER="github"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# If OIDC_PROVIDER="google"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""


# ==========================================
# Anti-Bot & FlareSolverr Configuration
# ==========================================

# Enable or disable FlareSolverr integration for bypassing Cloudflare protection ("true" or "false")
FLARESOLVERR_ENABLED=""

# FlareSolverr server endpoint URL (e.g., http://localhost:8191)
FLARESOLVERR_URL=""

# Request timeout for FlareSolverr in milliseconds
FLARESOLVERR_TIMEOUT=""

# Persistent session name for FlareSolverr
FLARESOLVERR_SESSION_NAME=""
